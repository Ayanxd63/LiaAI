<?xml version="1.0" encoding="utf-8"?>
<!--
  V15 (security P0) — auto-backup rules.
  The encrypted credential store (lia_secure_prefs) must NEVER be
  included in a Google Drive backup: a restored backup on another
  device cannot decrypt it anyway (Keystore keys do not travel), and
  the file must not leave the phone. Everything else — chat history,
  settings, facts — keeps backing up exactly as before.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="lia_secure_prefs.xml" />
    <!--
      V17 — the speaker voice-match profile is a biometric-adjacent
      embedding: it must never leave the phone in a backup. The
      cached memory-embedding vectors go with the facts they belong
      to (they are useless without them) and stay out of backups too.
    -->
    <exclude domain="file" path="speaker_profile.json" />
    <exclude domain="sharedpref" path="lia_fact_embeddings.xml" />
</full-backup-content>
