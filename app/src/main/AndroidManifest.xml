<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- V15: needed to check Wi-Fi before an offline-model download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- v10: draw the home character bubble over other apps (user-granted). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- V14: restart the always-listening service after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- V14: contacts + direct call (P1, guided setup in PermissionsScreen).
         READ_CONTACTS lets "Ammi ko call karo" resolve a name; CALL_PHONE
         lets Lia call directly without opening the dialer. Both are
         dangerous runtime permissions — the user grants them in-app. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- V14: Bluetooth enable dialog (runtime, Android 12+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- V14: package visibility for the apps Lia launches by name
         (Play-safe: explicit packages + launcher intent, never
         QUERY_ALL_PACKAGES, which stays direct-flavor-only). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.vending" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".LiaApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiaAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LiaAI.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".voice.VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- V14: restart always-listening after a reboot (only when the
             user turned it on; the receiver schedules the watchdog, which
             is the Android 15-safe route). -->
        <receiver
            android:name=".voice.WakeWordBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- V14: read + reply to notifications (user-granted in Settings;
             prominent in-app disclosure is shown BEFORE the system screen
             opens — see PermissionsScreen). -->
        <service
            android:name=".notification.LiaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- v10: floating home-character bubble over other apps. -->
        <service
            android:name=".ui.character.FloatingCharacterService"
            android:exported="false" />

        <!-- v10: Lia Voice Keyboard — speak to type in any app. -->
        <service
            android:name=".input.LiaKeyboardService"
            android:exported="true"
            android:label="@string/lia_voice_keyboard_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
